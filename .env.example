# ===== LUMI v3.0 — Environment Variables =====
# Copiar este arquivo para .env.local e preencher com seus valores
# NÃO fazer commit de .env (adicionar em .gitignore)

# ===== SUPABASE =====
# Obter em: https://app.supabase.com → Project Settings → API

# URL do projeto Supabase (termina com .supabase.co)
VITE_SUPABASE_URL=https://seu-projeto.supabase.co

# Chave pública (anonKey) — seguro para client-side
VITE_SUPABASE_ANON_KEY=sua-chave-publica-aqui

# Chave privada (serviceRoleKey) — APENAS server-side
SUPABASE_SERVICE_ROLE_KEY=sua-chave-privada-aqui

# ===== ANALYTICS & MONITORING =====
VITE_SENTRY_DSN=

# Ambiente (development, staging, production)
NODE_ENV=development

# ===== FEATURE FLAGS =====
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_PERFORMANCE_MONITORING=true

# ===== LOCAL DEVELOPMENT =====
VITE_PORT=5173

# ===== PRODUCTION SETTINGS =====
VITE_PUBLIC_URL=https://lumiensina.app.br

# ===== LOGGING =====
LOG_LEVEL=debug
