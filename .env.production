# ===== LUMI v3.1 — Environment Variables (PRODUÇÃO) =====
# Este arquivo é um TEMPLATE - preencher com valores reais via GitHub Secrets
# ⚠️ NUNCA committar credenciais reais neste arquivo

# ===== SUPABASE (PRODUÇÃO) =====
# Será substituído pelos valores do GitHub Secrets durante o deploy
VITE_SUPABASE_URL=${{ secrets.VITE_SUPABASE_URL }}
VITE_SUPABASE_ANON_KEY=${{ secrets.VITE_SUPABASE_ANON_KEY }}
SUPABASE_SERVICE_ROLE_KEY=${{ secrets.SUPABASE_SERVICE_ROLE_KEY }}

# ===== EDGE FUNCTIONS SECRETS =====
SEND_NOTIFICATIONS_SECRET_KEY=${{ secrets.SEND_NOTIFICATIONS_SECRET_KEY }}

# ===== NODE ENVIRONMENT =====
NODE_ENV=production

# ===== ANALYTICS & MONITORING =====
VITE_SENTRY_DSN=

# ===== FEATURE FLAGS =====
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_PERFORMANCE_MONITORING=true

# ===== PRODUCTION URL =====
VITE_PUBLIC_URL=https://lumiensina.app.br

# ===== LOGGING =====
LOG_LEVEL=info
